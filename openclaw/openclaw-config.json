{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "auth": {
      "token": "REPLACE_WITH_GATEWAY_TOKEN"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": []
      },
      "thinkingDefault": "off",
      "verboseDefault": "off",
      "imageModel": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": [
          "google/gemini-2.5-flash"
        ]
      },
      "models": {
        "google/gemini-2.5-pro": {
          "alias": "nano-banana-pro"
        },
        "google/gemini-2.5-flash": {}
      },
      "compaction": {
        "mode": "safeguard"
      },
      "subagents": {
        "model": "google/gemini-2.5-flash",
        "maxConcurrent": 1,
        "runTimeoutSeconds": 90,
        "archiveAfterMinutes": 30
      },
      "heartbeat": {
        "every": 55,
        "model": "google/gemini-2.5-flash",
        "target": "gateway",
        "ackMaxChars": 100,
        "activeHours": {
          "start": "07:00",
          "end": "23:00",
          "timezone": "America/Bogota"
        }
      },
      "timeoutSeconds": 300,
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 131072,
      "maxConcurrent": 4
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "REPLACE_WITH_TELEGRAM_BOT_TOKEN",
      "commands": {
        "native": true,
        "nativeSkills": true
      },
      "dmPolicy": "allowlist",
      "groups": {
        "*": {
          "requireMention": true
        },
        "-1003826801947": {
          "requireMention": false,
          "allowFrom": [
            "*"
          ]
        }
      },
      "tokenFile": "/home/node/.openclaw/secrets/telegram-default.token",
      "accounts": {
        "default": {
          "enabled": true,
          "botToken": "REPLACE_WITH_TELEGRAM_BOT_TOKEN",
          "tokenFile": "/home/node/.openclaw/secrets/telegram-default.token",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "6182588021"
          ]
        }
      },
      "allowFrom": [
        "6182588021"
      ]
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
