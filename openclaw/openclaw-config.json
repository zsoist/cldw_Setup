{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "dangerouslyAllowHostHeaderOriginFallback": true
    },
    "auth": {
      "token": "<REDACTED>"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": []
      },
      "thinkingDefault": "off",
      "verboseDefault": "off",
      "imageModel": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": []
      },
      "models": {
        "google/gemini-2.5-pro": {
          "alias": "nano-banana-pro"
        },
        "google/gemini-2.5-flash": {}
      },
      "compaction": {
        "mode": "safeguard"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "3m",
        "keepLastAssistants": 2,
        "minPrunableToolChars": 500
      },
      "subagents": {
        "model": "google/gemini-2.5-flash",
        "maxConcurrent": 1,
        "runTimeoutSeconds": 90,
        "archiveAfterMinutes": 30
      },
      "heartbeat": {
        "every": "180m",
        "model": "google/gemini-2.5-flash",
        "ackMaxChars": 100,
        "activeHours": {
          "start": "07:00",
          "end": "23:00",
          "timezone": "America/Bogota"
        }
      },
      "timeoutSeconds": 300,
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 32768,
      "maxConcurrent": 2
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "<REDACTED>",
      "commands": {
        "native": true,
        "nativeSkills": true
      },
      "dmPolicy": "allowlist",
      "groups": {
        "*": {
          "requireMention": true
        },
        "-1003826801947": {
          "requireMention": false,
          "allowFrom": [
            "*"
          ]
        }
      },
      "tokenFile": "/home/node/.openclaw/secrets/telegram-default.token",
      "accounts": {
        "default": {
          "enabled": true,
          "botToken": "<REDACTED>",
          "tokenFile": "/home/node/.openclaw/secrets/telegram-default.token",
          "dmPolicy": "allowlist",
          "allowFrom": [
            "6182588021"
          ]
        }
      },
      "allowFrom": [
        "6182588021"
      ]
    }
  },
  "models": {
    "providers": {
      "google": {
        "baseUrl": "https://generativelanguage.googleapis.com",
        "models": [
          {
            "name": "gemini-2.5-flash",
            "id": "gemini-2.5-flash",
            "cost": {
              "input": 0.15,
              "output": 0.6,
              "cacheRead": 0.0375
            }
          },
          {
            "name": "gemini-2.5-pro",
            "id": "gemini-2.5-pro",
            "cost": {
              "input": 1.25,
              "output": 10.0,
              "cacheRead": 0.3125
            }
          }
        ]
      }
    }
  },
  "tools": {
    "deny": [
      "browser",
      "canvas",
      "nodes",
      "tts",
      "image",
      "web_fetch"
    ],
    "web": {
      "search": {
        "provider": "brave",
        "enabled": true
      }
    },
    "media": {
      "concurrency": 2
    }
  },
  "plugins": {
    "entries": {
      "telegram": {
        "enabled": true
      }
    }
  }
}
