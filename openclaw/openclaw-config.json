{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "token": "REPLACE_WITH_GATEWAY_TOKEN"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google/gemini-2.5-flash",
        "fallbacks": [
          "anthropic/claude-haiku-4-5",
          "anthropic/claude-sonnet-4-6"
        ]
      },
      "thinkingDefault": "off",
      "verboseDefault": "off",
      "imageModel": {
        "primary": "google/gemini-2.5-pro",
        "fallbacks": [
          "google/gemini-2.5-flash"
        ]
      },
      "models": {
        "google/gemini-2.5-pro": {
          "alias": "nano-banana-pro"
        },
        "google/gemini-2.5-flash": {}
      },
      "compaction": {
        "mode": "safeguard"
      },
      "workspace": "/home/node/.openclaw/workspace",
      "contextTokens": 262144,
      "maxConcurrent": 4
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "REPLACE_WITH_TELEGRAM_BOT_TOKEN",
      "commands": {
        "native": true,
        "nativeSkills": true
      },
      "dmPolicy": "pairing",
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    }
  }
}
