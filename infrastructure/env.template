# === OpenClaw ===
OPENCLAW_IMAGE=openclaw:hetzner
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789
# Optional comma/space-separated explicit Control UI allowed origins, for example:
# OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=http://46.225.170.60:18789,https://claw.example.com
OPENCLAW_CONTROL_UI_ALLOWED_ORIGINS=
# Optional override for Host-header origin fallback when allowed origins are unset (0/1).
# Default is auto-enabled for non-loopback bind values.
OPENCLAW_CONTROL_UI_HOST_HEADER_FALLBACK=1
OPENCLAW_CONFIG_DIR=/root/.openclaw
OPENCLAW_WORKSPACE_DIR=/root/.openclaw/workspace
# Pin upstream OpenClaw commit/tag
OPENCLAW_REF=v2026.2.22
GOG_KEYRING_PASSWORD=
XDG_CONFIG_HOME=/home/node/.openclaw

# === Sentinel ===
SENTINEL_TELEGRAM_TOKEN=
SENTINEL_ALLOWED_USERS=
SENTINEL_PROVIDER=google
SENTINEL_MODEL=gemini-2.5-flash
SENTINEL_MAX_TOKENS=768
SENTINEL_USD_TO_COP_RATE=4000
SENTINEL_RATE_LIMIT_MAX_REQUESTS=8
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=300
SENTINEL_CONVERSATION_TTL_SECONDS=1800
SENTINEL_MAX_TOOL_ITERATIONS=5
SENTINEL_COST_TRACKING_ENABLED=1
SENTINEL_API_USAGE_LOG_FILE=/var/log/sentinel/api-usage.jsonl
SENTINEL_API_COST_SUMMARY_FILE=/var/log/sentinel/api-cost-summary.json
SENTINEL_COST_RETENTION_DAYS=180

# === Shared ===
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === Brave Search (AI Daily Brief grounding) ===
BRAVE_API_KEY=
AIDB_SEARCH_COUNTRY=us
AIDB_SEARCH_LANG=en
AIDB_BRAVE_COUNT=14
AIDB_BRAVE_MAX_URLS=14
AIDB_BRAVE_MAX_TOKENS=6144
AIDB_BRAVE_MAX_SNIPPETS=30
AIDB_BRAVE_MAX_TOKENS_PER_URL=2048
AIDB_BRAVE_MAX_SNIPPETS_PER_URL=20
AIDB_BRAVE_THRESHOLD_MODE=balanced
AIDB_BRAVE_GOGGLES=
AIDB_BRAVE_ENABLE_LOCAL=

# === OpenClaw Telegram ===
OPENCLAW_TELEGRAM_TOKEN=
# Comma/space separated numeric Telegram user IDs allowed to run DM commands.
# If set, rollout defaults dmPolicy to "allowlist" for OpenClaw Telegram.
OPENCLAW_TELEGRAM_ALLOW_FROM=
# Optional override: pairing | allowlist | open | disabled
OPENCLAW_TELEGRAM_DM_POLICY=
# Optional: comma/space-separated chat IDs or @usernames where OpenClaw may accept
# interactive Telegram commands outside DM (for example, a dedicated supergroup/channel thread).
# Example: OPENCLAW_TELEGRAM_INTERACTIVE_CHATS=-1003826801947
OPENCLAW_TELEGRAM_INTERACTIVE_CHATS=
# Optional: allow commands from channel/anonymous sender contexts in approved interactive chats.
# When enabled, sync sets groups.<interactive_chat>.allowFrom=["*"] for those chats only.
OPENCLAW_TELEGRAM_INTERACTIVE_ALLOW_ANY_SENDER=0
# Native Telegram slash command handlers.
# Set OPENCLAW_TELEGRAM_NATIVE_COMMANDS=0 when channel/anonymous sender mode is required.
OPENCLAW_TELEGRAM_NATIVE_COMMANDS=1
OPENCLAW_TELEGRAM_NATIVE_SKILLS=1
